#!/bin/sh
# upload-tool: send files listed in a file-list over mux channel -1 using a simple text protocol.
# Protocol (text-based):
#  - Bootloader sends: READY\n
#  - For each file entry in the list:
#      <path>\n
#      <size_decimal>\n
#      <binary file bytes>
#    A blank line in the file-list indicates the separator between kernel-phase and extra-phase files.
#    After each file is received, the bootloader responds with: ACK\n
#  - After all files, bootloader may respond and then the tool exits.

if [ "$#" -ne 1 ]; then
	echo "Usage: $0 <file-list>" >&2
	exit 2
fi

filelist="$1"
if [ ! -f "$filelist" ]; then
	echo "file-list not found: $filelist" >&2
	exit 2
fi

# Read file-list preserving blank lines
files=()
while IFS= read -r line || [ -n "$line" ]; do
	files+=("$line")
done < "$filelist"

# Wait for READY from bootloader
while IFS= read -r ready; do
	if [ "$ready" = "READY" ]; then
		break
	fi
done

# Send files
for path in "${files[@]}"; do
	# Send the path line (could be empty separator)
	printf "%s\n" "$path"
	if [ -z "$path" ]; then
		# separator: no size or file content follows
		# wait briefly for ACK or continue
		# Some bootloader implementations may not ACK separators; continue
		continue
	fi
	if [ ! -f "$path" ]; then
		echo "Missing file: $path" >&2
		exit 3
	fi
	size=$(wc -c < "$path" | tr -d '[:space:]')
	printf "%s\n" "$size"
	# send raw file content
	cat "$path"
	# wait for ACK line
	if ! IFS= read -r ack; then
		echo "Upload tool: EOF while waiting for ACK" >&2
		exit 4
	fi
	if [ "$ack" != "ACK" ]; then
		echo "Upload tool: expected ACK but got: $ack" >&2
		exit 5
	fi
done

# Signal done
printf "DONE\n"
exit 0
