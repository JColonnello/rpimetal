{
    "$schema": "https://cdn.statically.io/gh/nguyenngoclongdev/cdn/main/schema/v11/terminal-keeper.json",
    "theme": "tribe",
    "active": "plain",
    "activateOnStartup": true,
    "keepExistingTerminals": false,
    "sessions": {
        "muxed": [
            {
                "name": "Shell",
                "icon": "terminal",
                "color": "terminal.ansiGreen",
                "commands": [
                    ""
                ]
            },
            [
                {
                    "name": "stdout",
                    "autoExecuteCommands": true,
                    "icon": "output",
                    "color": "terminal.ansiBrightWhite",
                    "commands": [
                        "nc -lkvp 4440"
                    ]
                },
                {
                    "name": "stderr",
                    "autoExecuteCommands": true,
                    "icon": "error",
                    "color": "terminal.ansiRed",
                    "commands": [
                        "nc -lkvp 4441"
                    ]
                },
                {
                    "name": "QEMU",
                    "disabled": true,
                    "icon": "vm",
                    "color": "terminal.ansiMagenta",
                    "commands": [
                        "make run-vnc"
                    ]
                }
            ],
            {
                "name": "Muxer",
                "autoExecuteCommands": true,
                "icon": "plug",
                "color": "terminal.ansiCyan",
                "commands": [
                    "make mux-tcp"
                ]
            }
        ],
        "plain": [
            {
                "name": "Shell",
                "icon": "terminal",
                "color": "terminal.ansiGreen",
                "commands": [
                    ""
                ]
            },
            [
                {
                    "name": "Terminal",
                    "autoExecuteCommands": true,
                    "icon": "output",
                    "color": "terminal.ansiBrightWhite",
                    "commands": [
                        "nc -lkvp 4444"
                    ]
                },
                {
                    "name": "QEMU",
                    "disabled": true,
                    "icon": "vm",
                    "color": "terminal.ansiMagenta",
                    "commands": [
                        "make run-vnc"
                    ]
                }
            ]
        ]
    }
}