{
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.arguments": [
        "--query-driver=/opt/aarch64-none-elf/bin/aarch64-none-elf-gcc",
        "--background-index",
        "--clang-tidy",
        "--enable-config",
    ],
    "debug.allowBreakpointsEverywhere": true,
    "editor.detectIndentation": false,
    "editor.insertSpaces": false,
    "editor.tabSize": 4
}