{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Multiplex Debug",
			"type": "cppdbg",
			"request": "attach",
			"program": "${workspaceFolder}/multiplex",
			"MIMode": "gdb",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				},
				{
					"description": "Set Disassembly Flavor to Intel",
					"text": "-gdb-set disassembly-flavor intel",
					"ignoreFailures": true
				}
			],
			"sourceFileMap": {
				"${workspaceFolder}": {
					"editorPath": "${workspaceFolder}",
					"useForBreakpoints": "true"
				}
			},
		},
		{
			"name": "Debug (VNC)",
			"type": "cppdbg",
			"request": "launch",
			"miDebuggerServerAddress": ":1234",
			"miDebuggerPath": "aarch64-none-elf-gdb",
			"program": "./build/kernel8.elf",
			"cwd": "${workspaceFolder}",
			"MIMode": "gdb",
			"preLaunchTask": "debug-vnc",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": false
				},
				{
					"description": "Set Disassembly Flavor to Intel",
					"text": "-gdb-set disassembly-flavor intel",
					"ignoreFailures": true
				},
				{
					"description": "Output values as hex",
					"text": "-gdb-set output-radix 16",
					"ignoreFailures": false
				}
			],
			"postRemoteConnectCommands": [
				{
					"description": "Add command file (source)",
					"text": "source ${workspaceFolder}/.gdbinit",
					"ignoreFailures": false
				}
			],
			"sourceFileMap": {
				"${workspaceFolder}": {
					"editorPath": "${workspaceFolder}",
					"useForBreakpoints": "true"
				}
			},
		},
	]
}